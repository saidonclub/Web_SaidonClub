{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext",
      "ES2022"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ],
      "@saidonclub/database": [
        "../../packages/database/src/index.ts"
      ],
      "@saidonclub/config-engine": [
        "../../packages/config-engine/src/index.ts"
      ],
      "@saidonclub/mlm-engine": [
        "../../packages/mlm-engine/src/index.ts"
      ],
      "@saidonclub/types": [
        "../../packages/types/src/index.ts"
      ],
      "@saidonclub/rbac": [
        "../../packages/rbac/src/index.ts"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "../../packages/mlm-engine/src/**/*.ts",
    "../../packages/config-engine/src/**/*.ts",
    "../../packages/types/src/**/*.ts",
    "../../packages/rbac/src/**/*.ts",
    "../../packages/database/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scratch",
    "../../packages/database/prisma/**",
    "../../packages/database/seed_*.ts",
    "../../packages/mlm-engine/src/stress_test.ts"
  ]
}
