# ============================================================
# FILE:     pnpm-workspace.yaml
# AGENT:    System Architect
# PURPOSE:  Define los paquetes que forman parte del monorepo.
#           pnpm instala las dependencias compartidas en la raíz
#           y crea symlinks en cada package, ahorrando espacio.
# ============================================================
packages:
  - "apps/*"
  - "packages/*"
