generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/client_v2"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public"]
}

model SystemConfig {
  id              String          @id @default(uuid())
  key             String          @unique
  value           String
  type            ConfigType
  category        ConfigCategory
  description     String?
  editableBy      UserRole[]      @default([SUPER_ADMIN])
  requiresRestart Boolean         @default(false)
  dependencies    String[]
  validationRegex String?
  minValue        Decimal?        @db.Decimal(15, 4)
  maxValue        Decimal?        @db.Decimal(15, 4)
  allowedValues   String[]
  isActive        Boolean         @default(true)
  isPublic        Boolean         @default(false)
  displayOrder    Int             @default(0)
  groupName       String?
  icon            String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  updatedBy       String?
  history         ConfigHistory[]

  @@index([category])
  @@index([isActive])
  @@index([key, isActive])
  @@map("system_config")
  @@schema("public")
}

model ConfigHistory {
  id             String       @id @default(uuid())
  configId       String
  key            String
  oldValue       String
  newValue       String
  changedBy      String
  changedByEmail String
  reason         String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime     @default(now())
  config         SystemConfig @relation(fields: [configId], references: [id], onDelete: Cascade)

  @@index([configId])
  @@index([createdAt])
  @@map("config_history")
  @@schema("public")
}

model User {
  id                String             @id @default(uuid())
  email             String             @unique
  username          String             @unique
  name              String?
  phone             String?
  avatar            String?
  role              UserRole           @default(CLIENT)
  status            UserStatus         @default(ACTIVE)
  sponsorId         String?            @map("sponsor_id")
  affiliateCode     String             @unique @map("affiliate_code")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  cityId            String?            @map("city_id")
  activation        ActivationStatus?
  cart              Cart?
  commissions       Commission[]
  events            EventLog[]
  fidelity          FidelityTracking[]
  membership        Membership?
  providerOrders    Order[]            @relation("ProviderOrders")
  orders            Order[]
  pointsLedger      PointsLedger[]
  products          Product[]
  ranks             Rank[]
  seedBonuses       SeedBonus[]
  services          Service[]
  city              City?              @relation(fields: [cityId], references: [id])
  sponsor           User?              @relation("SponsorRelation", fields: [sponsorId], references: [id])
  referrals         User[]             @relation("SponsorRelation")
  wallet            Wallet?
  providerProfile   ProviderProfile?
  kycLevel          Int                @default(1)
  mustResetPassword Boolean            @default(false)
  lastLoginAt       DateTime?
  kyc               KYC?
  appointments      Appointment[]

  @@map("users")
  @@schema("public")
}

model VerificationToken {
  id         String           @id @default(uuid())
  identifier String
  token      String
  type       VerificationType
  expiresAt  DateTime
  createdAt  DateTime         @default(now())

  @@unique([identifier, token])
  @@map("verification_tokens")
  @@schema("public")
}

model ProviderProfile {
  id            String   @id @default(uuid())
  userId        String   @unique @map("user_id")
  companyName   String   @map("company_name")
  address       String?
  googleMapsUrl String?  @map("google_maps_url")
  logoUrl       String?  @map("logo_url")
  localPhotoUrl String?  @map("local_photo_url")
  whatsappPhone String?  @map("whatsapp_phone")
  contactEmail  String?  @map("contact_email")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("provider_profiles")
  @@schema("public")
}

model Membership {
  id               String         @id @default(uuid())
  userId           String         @unique @map("user_id")
  type             MembershipType
  price            Decimal        @db.Decimal(10, 2)
  purchaseDate     DateTime       @map("purchase_date")
  expiryDate       DateTime       @map("expiry_date")
  isUpgrade        Boolean        @default(false) @map("is_upgrade")
  includesProducts Boolean        @default(false) @map("includes_products")
  productOrderId   String?        @map("product_order_id")
  createdAt        DateTime       @default(now())
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("memberships")
  @@schema("public")
}

model ActivationStatus {
  id             String         @id @default(uuid())
  userId         String         @unique @map("user_id")
  isActive       Boolean        @map("is_active")
  activationType ActivationType @map("activation_type")
  points30d      Decimal        @default(0) @map("points_30d") @db.Decimal(10, 2)
  lastChecked    DateTime       @map("last_checked")
  updatedAt      DateTime       @updatedAt
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("activation_status")
  @@schema("public")
}

model Category {
  id                   String       @id @default(uuid())
  name                 String
  slug                 String       @unique
  type                 CategoryType
  parentId             String?      @map("parent_id")
  icon                 String?
  description          String?
  isMembershipCategory Boolean      @default(false) @map("is_membership_category")
  isActive             Boolean      @default(true) @map("is_active")
  createdAt            DateTime     @default(now())
  parent               Category?    @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children             Category[]   @relation("CategoryHierarchy")
  products             Product[]
  services             Service[]

  @@map("categories")
  @@schema("public")
}

model Product {
  id                    String          @id @default(uuid())
  code                  String?         @unique @default(uuid())
  name                  String
  description           String
  slug                  String          @unique
  pricePVP              Decimal         @map("price_pvp") @db.Decimal(10, 2)
  priceSaidon           Decimal         @map("price_saidon") @db.Decimal(10, 2)
  pointsEarned          Decimal         @map("points_earned") @db.Decimal(10, 2)
  cost                  Decimal         @db.Decimal(10, 2)
  tax                   Decimal         @default(0) @db.Decimal(10, 2)
  logistics             Decimal         @default(0) @db.Decimal(10, 2)
  margin                Decimal         @db.Decimal(10, 2)
  stock                 Int             @default(0)
  images                String[]
  videos                String[]        @default([])
  attributes            Json?           @default("{}")
  options               Json?           @default("[]")
  categoryId            String          @map("category_id")
  providerId            String          @map("provider_id")
  status                ProductStatus   @default(PENDING)
  isActive              Boolean         @default(true) @map("is_active")
  isGiftProduct         Boolean         @default(false) @map("is_gift_product")
  giftForMembershipType MembershipType? @map("gift_for_membership_type")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  cityId                String?         @map("city_id")
  cartItems             CartItem[]
  orderItems            OrderItem[]
  category              Category        @relation(fields: [categoryId], references: [id])
  city                  City?           @relation(fields: [cityId], references: [id])
  provider              User            @relation(fields: [providerId], references: [id])

  @@map("products")
  @@schema("public")
}

model Service {
  id             String        @id @default(uuid())
  code           String?       @unique @default(uuid())
  name           String
  description    String
  slug           String        @unique
  pricePVP       Decimal       @map("price_pvp") @db.Decimal(10, 2)
  priceSaidon    Decimal       @map("price_saidon") @db.Decimal(10, 2)
  pointsEarned   Decimal       @map("points_earned") @db.Decimal(10, 2)
  cost           Decimal       @db.Decimal(10, 2)
  tax            Decimal       @default(0) @db.Decimal(10, 2)
  commissionRate Decimal       @default(0.05) @map("commission_rate") @db.Decimal(5, 4)
  images         String[]      @default([])
  videos         String[]      @default([])
  attributes     Json?         @default("{}")
  categoryId     String        @map("category_id")
  providerId     String        @map("provider_id")
  location       String?
  status         ServiceStatus @default(PENDING)
  isActive       Boolean       @default(true) @map("is_active")
  createdAt      DateTime      @default(now())
  cityId         String?       @map("city_id")
  cartItems      CartItem[]
  orderItems     OrderItem[]
  appointments   Appointment[]
  category       Category      @relation(fields: [categoryId], references: [id])
  city           City?         @relation(fields: [cityId], references: [id])
  provider       User          @relation(fields: [providerId], references: [id])

  @@map("services")
  @@schema("public")
}

model Cart {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
  @@schema("public")
}

model CartItem {
  id         String   @id @default(uuid())
  cartId     String   @map("cart_id")
  productId  String?  @map("product_id")
  serviceId  String?  @map("service_id")
  quantity   Int      @default(1)
  priceAtAdd Decimal  @map("price_at_add") @db.Decimal(10, 2)
  options    Json?    @default("{}")
  createdAt  DateTime @default(now())
  cart       Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])
  service    Service? @relation(fields: [serviceId], references: [id])

  @@map("cart_items")
  @@schema("public")
}

model Order {
  id                    String          @id @default(uuid())
  userId                String          @map("user_id")
  providerId            String?         @map("provider_id")
  status                OrderStatus     @default(PENDING)
  totalAmount           Decimal         @map("total_amount") @db.Decimal(10, 2)
  pointsUsed            Decimal         @default(0) @map("points_used") @db.Decimal(10, 2)
  pointsEarned          Decimal         @default(0) @map("points_earned") @db.Decimal(10, 2)
  affiliateCode         String?         @map("affiliate_code")
  paymentMethod         PaymentMethod
  paymentStatus         PaymentStatus   @default(PENDING)
  stripePaymentIntentId String?         @map("stripe_payment_intent_id")
  isMembershipOrder     Boolean         @default(false) @map("is_membership_order")
  membershipType        MembershipType? @map("membership_type")
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  commission            Commission?
  items                 OrderItem[]
  provider              User?           @relation("ProviderOrders", fields: [providerId], references: [id])
  user                  User            @relation(fields: [userId], references: [id])

  @@map("orders")
  @@schema("public")
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String   @map("order_id")
  productId  String?  @map("product_id")
  serviceId  String?  @map("service_id")
  quantity   Int
  unitPrice  Decimal  @map("unit_price") @db.Decimal(10, 2)
  totalPrice Decimal  @map("total_price") @db.Decimal(10, 2)
  options    Json?    @default("{}")
  isGift     Boolean  @default(false) @map("is_gift")
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product    Product? @relation(fields: [productId], references: [id])
  service    Service? @relation(fields: [serviceId], references: [id])

  @@map("order_items")
  @@schema("public")
}

model PointsLedger {
  id          String      @id @default(uuid())
  userId      String      @map("user_id")
  sourceType  PointSource @map("source_type")
  amount      Decimal     @db.Decimal(10, 2)
  cycleMonth  Int         @map("cycle_month")
  cycleYear   Int         @map("cycle_year")
  orderId     String?     @map("order_id")
  description String?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("points_ledger")
  @@schema("public")
}

model Wallet {
  id               String              @id @default(uuid())
  userId           String              @unique @map("user_id")
  balancePending   Decimal             @default(0) @map("balance_pending") @db.Decimal(12, 2)
  balanceValidated Decimal             @default(0) @map("balance_validated") @db.Decimal(12, 2)
  balanceAvailable Decimal             @default(0) @map("balance_available") @db.Decimal(12, 2)
  balanceDebt      Decimal             @default(0) @map("balance_debt") @db.Decimal(12, 2)
  totalEarned      Decimal             @default(0) @map("total_earned") @db.Decimal(12, 2)
  totalWithdrawn   Decimal             @default(0) @map("total_withdrawn") @db.Decimal(12, 2)
  lastClosureDate  DateTime?           @map("last_closure_date")
  updatedAt        DateTime            @updatedAt
  transactions     WalletTransaction[]
  user             User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
  @@schema("public")
}

model WalletTransaction {
  id          String            @id @default(uuid())
  walletId    String            @map("wallet_id")
  type        TransactionType
  amount      Decimal           @db.Decimal(12, 2)
  status      TransactionStatus @default(PENDING)
  description String?
  metadata    Json?
  createdAt   DateTime          @default(now())
  wallet      Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("wallet_transactions")
  @@schema("public")
}

model Commission {
  id          String           @id @default(uuid())
  userId      String           @map("user_id")
  orderId     String?          @unique @map("order_id")
  referralId  String?          @map("referral_id")
  type        CommissionType
  level       Int?
  percentage  Decimal?         @db.Decimal(5, 2)
  pointsValue Decimal          @map("points_value") @db.Decimal(10, 2)
  amount      Decimal          @db.Decimal(10, 2)
  cycleMonth  Int              @map("cycle_month")
  cycleYear   Int              @map("cycle_year")
  status      CommissionStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  order       Order?           @relation(fields: [orderId], references: [id])
  user        User             @relation(fields: [userId], references: [id])

  @@map("commissions")
  @@schema("public")
}

model SeedBonus {
  id                    String         @id @default(uuid())
  userId                String         @map("user_id")
  membershipPurchaserId String         @map("membership_purchaser_id")
  membershipType        MembershipType @map("membership_type")
  level                 Int
  amount                Decimal        @db.Decimal(10, 2)
  sourceFund            String         @map("source_fund")
  createdAt             DateTime       @default(now())
  user                  User           @relation(fields: [userId], references: [id])

  @@map("seed_bonuses")
  @@schema("public")
}

model Rank {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  rankName       RankName @map("rank_name")
  requiredPoints Decimal  @map("required_points") @db.Decimal(12, 2)
  monthlyBonus   Decimal  @map("monthly_bonus") @db.Decimal(10, 2)
  cycleMonth     Int      @map("cycle_month")
  cycleYear      Int      @map("cycle_year")
  achievedDate   DateTime @map("achieved_date")
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ranks")
  @@schema("public")
}

model FidelityTracking {
  id                String         @id @default(uuid())
  userId            String         @map("user_id")
  rankName          String         @map("rank_name")
  period            FidelityPeriod
  consecutiveMonths Int            @default(1) @map("consecutive_months")
  status            FidelityStatus @default(IN_PROGRESS)
  achievedDate      DateTime?      @map("achieved_date")
  createdAt         DateTime       @default(now())
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("fidelity_tracking")
  @@schema("public")
}

model WeeklyClosure {
  id                String        @id @default(uuid())
  closureDate       DateTime      @map("closure_date")
  status            ClosureStatus @default(DETECTING)
  totalCommissions  Decimal       @map("total_commissions") @db.Decimal(12, 2)
  totalSeedBonus    Decimal       @map("total_seed_bonus") @db.Decimal(12, 2)
  totalPaid         Decimal       @map("total_paid") @db.Decimal(12, 2)
  detectionStarted  DateTime?     @map("detection_started")
  detectionEnded    DateTime?     @map("detection_ended")
  validationStarted DateTime?     @map("validation_started")
  validationEnded   DateTime?     @map("validation_ended")
  createdAt         DateTime      @default(now())

  @@map("weekly_closures")
  @@schema("public")
}

model EventLog {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  aggregateType String   @map("aggregate_type")
  eventType     String   @map("event_type")
  payload       Json
  createdAt     DateTime @default(now())
  version       Int      @default(1)
  user          User?    @relation(fields: [userId], references: [id])

  @@map("event_logs")
  @@schema("public")
}

model FundsReserve {
  id              String    @id @default(uuid())
  fundType        FundType  @map("fund_type")
  totalAmount     Decimal   @map("total_amount") @db.Decimal(12, 2)
  committedAmount Decimal   @map("committed_amount") @db.Decimal(12, 2)
  availableAmount Decimal   @map("available_amount") @db.Decimal(12, 2)
  lastAuditedDate DateTime? @map("last_audited_date")
  lastAuditedBy   String?   @map("last_audited_by")
  updatedAt       DateTime  @updatedAt

  @@map("funds_reserve")
  @@schema("public")
}

model ExternalClientSession {
  id           String   @id @default(uuid())
  sessionId    String   @unique @map("session_id")
  linkOwnerId  String   @map("link_owner_id")
  createdAt    DateTime @default(now())
  lastActivity DateTime @map("last_activity")
  expiryAt     DateTime @map("expiry_at")
  isExpired    Boolean  @default(false) @map("is_expired")

  @@map("external_client_sessions")
  @@schema("public")
}

model CityDiscount {
  id              String    @id @default(uuid())
  cityName        String    @map("city_name")
  countryCode     String    @map("country_code")
  discountPercent Decimal   @map("discount_percent") @db.Decimal(5, 2)
  isActive        Boolean   @default(true) @map("is_active")
  validFrom       DateTime  @map("valid_from")
  validUntil      DateTime? @map("valid_until")
  createdAt       DateTime  @default(now())

  @@map("city_discounts")
  @@schema("public")
}

model Country {
  id          String     @id @default(uuid())
  name        String     @unique
  code        String     @unique
  currency    String     @default("USD")
  phonePrefix String     @map("phone_prefix")
  flag        String?
  isActive    Boolean    @default(true) @map("is_active")
  createdAt   DateTime   @default(now())
  lat         Decimal?   @db.Decimal(10, 7)
  lon         Decimal?   @db.Decimal(10, 7)
  cities      City[]
  provinces   Province[]

  @@map("countries")
  @@schema("public")
}

model Province {
  id        String   @id @default(uuid())
  name      String
  countryId String   @map("country_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  lat       Decimal? @db.Decimal(10, 7)
  lon       Decimal? @db.Decimal(10, 7)
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  cities    City[]

  @@unique([name, countryId])
  @@map("provinces")
  @@schema("public")
}

model City {
  id         String     @id @default(uuid())
  name       String
  countryId  String     @map("country_id")
  provinceId String?    @map("province_id")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now())
  lat        Decimal?   @db.Decimal(10, 7)
  lon        Decimal?   @db.Decimal(10, 7)
  country    Country    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  province   Province?  @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  districts  District[]
  products   Product[]
  services   Service[]
  users      User[]

  @@unique([name, countryId, provinceId])
  @@map("cities")
  @@schema("public")
}

model District {
  id        String   @id @default(uuid())
  name      String
  cityId    String   @map("city_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now())
  lat       Decimal? @db.Decimal(10, 7)
  lon       Decimal? @db.Decimal(10, 7)
  city      City     @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@unique([name, cityId])
  @@map("districts")
  @@schema("public")
}

model TickerMessage {
  id           String   @id @default(uuid())
  text         String
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("ticker_messages")
  @@schema("public")
}

model Appointment {
  id                String            @id @default(uuid())
  serviceId         String            @map("service_id")
  clientId          String            @map("client_id")
  scheduledAt       DateTime          @map("scheduled_at")
  status            AppointmentStatus @default(SOLICITADA)
  qrCode            String            @unique @map("qr_code")
  qrScannedAt       DateTime?         @map("qr_scanned_at")
  qrScannerLat      Decimal?          @map("qr_scanner_lat") @db.Decimal(10, 8)
  qrScannerLng      Decimal?          @map("qr_scanner_lng") @db.Decimal(11, 8)
  clientConfirmed   Boolean           @default(false) @map("client_confirmed")
  providerNotes     String?           @map("provider_notes") @db.Text
  clientRating      Int?              @map("client_rating")
  clientReview      String?           @map("client_review") @db.Text
  pointsDistributed Boolean           @default(false) @map("points_distributed")
  createdAt         DateTime          @default(now())
  completedAt       DateTime?         @map("completed_at")
  service           Service           @relation(fields: [serviceId], references: [id])
  client            User              @relation(fields: [clientId], references: [id])

  @@index([serviceId])
  @@index([clientId])
  @@index([status])
  @@index([scheduledAt])
  @@map("appointments")
  @@schema("public")
}

model KYC {
  id             String    @id @default(uuid())
  userId         String    @unique @map("user_id")
  level          Int       @default(1)
  documentType   String?   @map("document_type")
  documentNumber String?   @map("document_number")
  documentUrl    String?   @map("document_url")
  selfieUrl      String?   @map("selfie_url")
  status         KYCStatus @default(PENDIENTE)
  verifiedAt     DateTime? @map("verified_at")
  verifiedBy     String?   @map("verified_by")
  rejectionNote  String?   @map("rejection_note")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([level])
  @@map("kyc")
  @@schema("public")
}

model AuditLog {
  id           String      @id @default(uuid())
  userId       String?     @map("user_id")
  targetUserId String?     @map("target_user_id")
  action       AuditAction
  entityType   String      @map("entity_type")
  entityId     String?     @map("entity_id")
  oldValue     Json?       @map("old_value")
  newValue     Json?       @map("new_value")
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([targetUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([action])
  @@map("audit_logs")
  @@schema("public")
}

enum AppointmentStatus {
  SOLICITADA
  CONFIRMADA
  PAGADA
  POR_ATENDER
  COMPLETADA
  POR_CALIFICAR
  CALIFICADA
  CANCELADA
  NO_SHOW

  @@schema("public")
}

enum KYCStatus {
  PENDIENTE
  EN_REVISION
  APROBADO
  RECHAZADO

  @@schema("public")
}

enum ConfigType {
  BOOLEAN
  NUMBER
  DECIMAL
  STRING
  JSON
  ARRAY
  CRON
  EMAIL
  URL
  COLOR

  @@schema("public")
}

enum ConfigCategory {
  GENERAL
  AUTH
  MARKETPLACE
  MLM
  MEMBERSHIP
  WALLET
