{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "src",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": [
      "ES2022",
      "dom"
    ],
    "composite": true,
    "declaration": true,
    "declarationDir": "./dist",
    "skipLibCheck": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/stress_test.ts",
    "src/__tests__"
  ],
  "references": [
    { "path": "../database" },
    { "path": "../config-engine" }
  ]
}
