{
  "name": "@saidonclub/database",
  "version": "5.2.0",
  "description": "Prisma + Supabase infrastructure with Multi-schema support.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "node -e \"try{require('fs').unlinkSync('tsconfig.tsbuildinfo')}catch(e){}\" && tsc && node scripts/copy-generated.js",
    "db:generate": "pnpm exec prisma generate --schema=prisma/schema.prisma && node scripts/copy-generated.js",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed-maestro": "tsx prisma/seed_maestro.ts",
    "db:seed-omega": "tsx prisma/seed_omega.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^5.12.0",
    "@supabase/supabase-js": "^2.42.0",
    "@types/pg": "^8.20.0",
    "dotenv": "^17.4.2",
    "pg": "^8.20.0",
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "prisma": "^5.12.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
