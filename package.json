{
  "name": "saidonclub-os",
  "private": true,
  "version": "5.2.0",
  "description": "SaidonClub OS — Advanced Marketplace, MLM & Services Platform. Multi-country, Multi-city, Multi-schema.",
  "scripts": {
    "build": "turbo run build",
    "prebuild": "pnpm db:generate",
    "postinstall": "pnpm db:generate",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "typecheck": "turbo run typecheck",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:stress": "tsx tests/stress_standalone.ts",
    "test:audit": "pnpm test:stress"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-react": "^4.2.1",
    "jsdom": "^24.0.0",
    "playwright": "^1.59.1",
    "prettier": "^3.2.0",
    "tsx": "^4.7.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.4.0"
  },
  "packageManager": "pnpm@9.0.0",
  "pnpm": {
    "overrides": {
      "cross-spawn": ">=7.0.5",
      "vite": ">=6.4.2",
      "uuid": ">=14.0.0",
      "postcss": ">=8.5.10"
    }
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "sharp": "^0.33.5",
    "stripe": "^22.1.0"
  }
}
