# =================================================================
# SAIDONCLUB OS v5.1 — Variables de Entorno
# =================================================================
# INSTRUCCIONES:
#   1. Copia este archivo como .env (en la raíz del monorepo)
#   2. Nunca commitear .env al repositorio — está en .gitignore
#   3. Los valores marcados con (*) son OBLIGATORIOS para go-live
#   4. Los valores con [TEST] son para desarrollo local
# =================================================================

# ── SUPABASE (OBLIGATORIO) ────────────────────────────────────
# * URL del proyecto Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# * Clave anon pública (segura para el cliente)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# * Clave de servicio (SOLO en servidor/Edge Functions — NUNCA en cliente)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── PRISMA / DATABASE ─────────────────────────────────────────
# * URL de conexión directa a PostgreSQL (para migraciones)
DATABASE_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
# * URL de conexión pooled (para runtime via PgBouncer — performance)
DIRECT_URL=postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres

# ── NEXT.JS ───────────────────────────────────────────────────
# URL pública de la aplicación web
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secreto para NextAuth/cookies (min 32 chars)
NEXTAUTH_SECRET=your-super-secret-key-min-32-chars-here
NEXTAUTH_URL=http://localhost:3000

# ── PAGOS (Configurar antes de go-live) ───────────────────────
# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# Stripe (alternativa)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── NOTIFICACIONES ────────────────────────────────────────────
# Email (Resend recomendado — gratuito hasta 3k/mes)
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@saidonclub.com

# Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# ── ALMACENAMIENTO (Supabase Storage — gratuito 1GB) ──────────
NEXT_PUBLIC_STORAGE_BUCKET=saidonclub-assets
SUPABASE_STORAGE_URL=https://your-project.supabase.co/storage/v1

# ── CONFIGURACIÓN DE RUNTIME ─────────────────────────────────
# Entorno: development | staging | production
NODE_ENV=development
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Timezone del servidor (Ecuador)
TZ=America/Guayaquil
